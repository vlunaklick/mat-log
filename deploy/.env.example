# Configure these values in Coolify > bjj > production > mat-log > Environment Variables.
# Never commit real values. Coolify generates the service .env file.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
COACH_MODEL=gemini-3.5-flash
# Optional free Coach fallback. Its model is fixed to openrouter/free.
OPENROUTER_API_KEY=
# Optional: extra sign-in origins, e.g. the Tailscale name served via `tailscale serve`
TRUSTED_ORIGINS=https://bjj.tailb7c175.ts.net
